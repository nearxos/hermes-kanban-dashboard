# Optional direct browser origin. Leave empty to use the same-origin proxy.
# VITE_HERMES_KANBAN_ORIGIN=http://127.0.0.1:8790
VITE_HERMES_KANBAN_ORIGIN=

# Target used by Vite dev/preview proxy when /hermes-api is requested.
# This keeps browser requests same-origin and avoids CORS.
HERMES_KANBAN_PROXY_TARGET=http://127.0.0.1:8790
